<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>StangaNetLib.Auth</AssemblyName>
    <RootNamespace>StangaNetLib.Auth</RootNamespace>
    <Version>1.1.0</Version>
    <Description>JWT authentication with per-device refresh token rotation, BCrypt password hashing, cache-backed token revocation blacklist, Auth0 integration (JWKS + Management API), and external identity token exchange (Google, Apple, Facebook, Microsoft). Depends on StangaNetLib.Caching and StangaNetLib.Resilience.</Description>
    <PackageTags>jwt;auth0;authentication;refresh-token;bcrypt;password;google;apple;facebook;microsoft;oidc;external;aspnetcore;stanganet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StangaNetLib.Auth.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="StangaNetLib.Caching" />
    <PackageReference Include="StangaNetLib.Resilience" />

    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" VersionOverride="8.*" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" VersionOverride="9.*" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" VersionOverride="10.*" Condition="'$(TargetFramework)' == 'net10.0'" />

    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="BCrypt.Net-Next" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\build\**" Pack="true" PackagePath="build/" />
  </ItemGroup>

  <Target Name="StampBuildProps" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_BuildPropsFile>$(MSBuildThisFileDirectory)..\..\build\StangaNetLib.Auth.props</_BuildPropsFile>
    </PropertyGroup>
    <ItemGroup>
      <_BPLines Include="&lt;Project&gt;" />
      <_BPLines Include="  &lt;ItemGroup&gt;" />
      <_BPLines Include="    &lt;AssemblyAttribute Include=&quot;System.Reflection.AssemblyMetadataAttribute&quot;&gt;" />
      <_BPLines Include="      &lt;_Parameter1&gt;StangaNetLib.Auth&lt;/_Parameter1&gt;" />
      <_BPLines Include="      &lt;_Parameter2&gt;$(Version)&lt;/_Parameter2&gt;" />
      <_BPLines Include="    &lt;/AssemblyAttribute&gt;" />
      <_BPLines Include="  &lt;/ItemGroup&gt;" />
      <_BPLines Include="&lt;/Project&gt;" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(_BuildPropsFile)"
      Lines="@(_BPLines)"
      Overwrite="true"
      Encoding="UTF-8" />
    <Message Text="StangaNetLib.Auth: stamped build props with version $(Version)" Importance="high" />
  </Target>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\package-icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
